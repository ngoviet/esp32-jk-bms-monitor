# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.

# ESPHome build files
/.esphome/

# Security - NEVER commit these files
/secrets.yaml
secrets.yaml
*.secrets.yaml

# Logs and temporary files
*.log
*.tmp
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
*~
