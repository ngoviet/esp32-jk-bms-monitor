# 🔐 ESPHome Secrets Configuration Template
# 
# HƯỚNG DẪN BẢO MẬT:
# 1. Copy file này thành "secrets.yaml" 
# 2. Thay đổi tất cả values thành thông tin thực tế
# 3. KHÔNG BAO GIỜ commit file secrets.yaml lên Git
# 4. Sử dụng passwords mạnh (ít nhất 12 ký tự, có chữ hoa, số, ký tự đặc biệt)

# WiFi Configuration
wifi_ssid: "Your_WiFi_Network_Name"
wifi_password: "Your_Strong_WiFi_Password_123#"

# WiFi Access Point Selection (tùy chọn theo môi trường)
# Nếu có nhiều AP cùng SSID, có thể chỉ định BSSID và channel cụ thể
# Để trống hoặc xóa dòng nếu không cần chỉ định cụ thể

# AP Option 1 (ví dụ: Router chính)
wifi_bssid_t1: "aa:bb:cc:dd:ee:f1"
wifi_channel_t1: 1

# AP Option 2 (ví dụ: Repeater)
wifi_bssid_t2: "aa:bb:cc:dd:ee:f2" 
wifi_channel_t2: 6

# AP Option 3 (ví dụ: Mesh node)
wifi_bssid_t3: "aa:bb:cc:dd:ee:f3"
wifi_channel_t3: 11

# OTA Password - Dùng để cập nhật firmware từ xa
# Nên là password mạnh khác với WiFi password
ota_password: "Your_Strong_OTA_Password_456#"

# API Encryption Key (optional) - Bảo mật API
# Tạo random 32 ký tự: openssl rand -hex 32
api_key: "abcdef1234567890abcdef1234567890"

# Home Assistant Details (nếu cần)
ha_url: "http://homeassistant.local:8123"
ha_token: "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."