# Mẫu secrets cho ESPHome
# 1. Chép thành "secrets.yaml" (đã nằm trong .gitignore, KHÔNG commit)
# 2. Điền giá trị thật

# Wi-Fi nhà. Không ghim BSSID/kênh: thiết bị tự quét và chọn AP mạnh nhất.
wifi_ssid: "Ten_WiFi"
wifi_password: "Mat_khau_WiFi"

# Mật khẩu nạp OTA qua mạng. Đổi giá trị này thì lần nạp kế tiếp phải qua USB.
ota_password: "Mat_khau_OTA"

# Mật khẩu điểm truy cập cứu hộ "<tên thiết bị>-cuu", phát ra khi thiết bị
# không vào được Wi-Fi nhà sau 1 phút (ít nhất 8 ký tự).
ap_password: "Mat_khau_AP_cuu_ho"

# Khoá mã hoá API (chưa dùng: bật thì phải nhập lại khoá trong Home Assistant).
# Tạo: openssl rand -base64 32
api_key: ""
